# ==============================================================================
# DREAM CAR HOUSE - Production Environment Variable Specification Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.production on the server:
#    cp .env.production.example .env.production
# 2. Replace all CHANGE_ME placeholders with strong, unique production values.
#    (deploy.sh will abort if any required variable still contains CHANGE_ME).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED CONFIGURATION (Mandatory for deploy.sh and core operation)
# ------------------------------------------------------------------------------

# PostgreSQL Database Credentials
POSTGRES_DB=CHANGE_ME_DB_NAME
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Django Cryptographic Secret Key (Generate: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=CHANGE_ME_50_CHARACTER_MINIMUM_RANDOM_SECRET_KEY

# Allowed Host Header Domains (comma-separated).
# IMPORTANT: "backend" is mandatory so internal Docker container calls from Next.js (frontend SSR and dashboard)
# calling http://backend:8000 pass Django's Host header validation.
ALLOWED_HOSTS=dreamcarhouse.com,www.dreamcarhouse.com,backend,localhost,127.0.0.1

# Cross-Origin Resource Sharing (CORS) - Allowed Client Origins
CORS_ALLOWED_ORIGINS=https://dreamcarhouse.com,https://www.dreamcarhouse.com

# Cross-Site Request Forgery (CSRF) - Trusted Origins
CSRF_TRUSTED_ORIGINS=https://dreamcarhouse.com,https://www.dreamcarhouse.com

# Public Canonical Origin for Frontend Client (baked in at build time)
NEXT_PUBLIC_BASE_URL=https://dreamcarhouse.com

# Public Base URL for media assets, Schema.org / JSON-LD structured data, and SEO OpenGraph tags (REQUIRED)
PUBLIC_BASE_URL=https://dreamcarhouse.com


# ------------------------------------------------------------------------------
# 2. OPTIONAL CONFIGURATION (Sensible production defaults provided)
# ------------------------------------------------------------------------------

# Django Debug Mode (Strictly False in production; defaults to False if omitted)
JTRO_DEBUG=False

# SSL & Reverse Proxy Security (Set True once SSL / Cloudflare proxy is active)
JTRO_SSL_ENABLED=False

# Dashboard Cookie Secure Flag (Default: False for HTTP first boot. Set True once HTTPS/SSL is active)
DASHBOARD_COOKIE_SECURE=false

# HTTP Strict Transport Security (HSTS) - Default: 3600 (1 hour). Increase to 31536000 after SSL verification.
JTRO_HSTS_SECONDS=3600

# Optional HSTS Subdomain & Preload enforcement (Defaults: False)
JTRO_HSTS_INCLUDE_SUBDOMAINS=False
JTRO_HSTS_PRELOAD=False

# Internal Docker Networking (Defaults configured in docker-compose.yml)
INTERNAL_BACKEND_URL=http://backend:8000
DASHBOARD_API_ORIGIN=http://backend:8000
REDIS_URL=redis://redis:6379/1
# Optional Celery Configuration (Uncomment if Celery worker service is enabled in docker-compose.yml)
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# Next.js On-Demand ISR Revalidation Secret (Generate: python -c "import secrets; print(secrets.token_hex(16))")
REVALIDATE_SECRET=CHANGE_ME_REVALIDATE_TOKEN

# MaxMind GeoLite2 MMDB Directory (Defaults to bundled /app/GeoLite2City in backend container)
GEOIP_PATH=/app/GeoLite2City

# Reverse Proxy Real-IP Extraction (Django parses X-Forwarded-For from trusted Nginx proxy)
TRUSTED_PROXY_IPS=127.0.0.1,::1,localhost,172.16.0.0/12,10.0.0.0/8
NUM_PROXIES=1
USE_X_FORWARDED_FOR=True
