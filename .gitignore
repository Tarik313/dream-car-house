# ========================================================
# DREAM CAR HOUSE - Git Ignore Specification
# ========================================================

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.production.example
!.env.example
*.env
*.env.*
frontend/.env*
!frontend/.env.example
dashboard/.env*
!dashboard/.env.example
backend/.env*
!backend/.env.example

# Local SQLite Databases
*.sqlite3
*.db
backend/db.sqlite3

# Media, Uploads & Assets
backend/media_root/
backend/media/
backend/images/
backend/static_root/
static_root/
images/
media/

# Database Dumps, Fixtures & Backups
backend/sqlite_backup.json
*_backup.json
*backup*.json
*.sql
*.dump
*dump*.json
datadump.json

# Python artifacts
*.pyc
__pycache__/

# Node.js artifacts
node_modules/
.next/
*.tsbuildinfo

# Scratch & Temporary Logs
LastPromptsOutput.txt
scratch/
*/scratch/
frontend/scratch/
dream_car_house/scratch/